# ============================================================================
# ClipForge environment configuration
# Copy this file to `.env` and adjust. NEVER commit real secrets.
# ============================================================================

# --- App ---
ENVIRONMENT=development
DEBUG=false

# --- Security ---
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=clipforge
POSTGRES_PASSWORD=clipforge
POSTGRES_DB=clipforge
# App connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://clipforge:clipforge@localhost:5432/clipforge

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
PROCESSING_QUEUE=clipforge:jobs

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=524288000

# --- AI provider ---
# "mock" runs fully offline (demo mode). Set "openai" and provide a key for real AI.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# --- Compose convenience ---
# Seed demo user + sample videos when the API container starts.
SEED_ON_START=true

# --- Frontend (Vite dev server proxy target) ---
VITE_API_PROXY_TARGET=http://localhost:8000
