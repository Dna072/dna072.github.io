# ---------------------------------------------------------------------------
# ClipForge — root environment template
# Copy to `.env` in this directory before running docker compose.
# ---------------------------------------------------------------------------

# --- Security (override in production!) ---
JWT_SECRET_KEY=dev-insecure-change-me

# --- AI ---
# auto = OpenAI when OPENAI_API_KEY is set, otherwise deterministic mock
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frontend (used by Vite at build/dev time) ---
VITE_API_URL=http://localhost:8000
