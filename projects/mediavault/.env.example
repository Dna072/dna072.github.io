# -------- MediaVault environment (copy to .env) --------
# Never commit real secrets. These defaults are for local development only.

# --- Core ---
ENVIRONMENT=local
LOG_JSON=true
LOG_LEVEL=INFO

# --- Security (generate strong random values in production) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
SIGNED_URL_SECRET=dev-signed-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
SIGNED_URL_EXPIRE_SECONDS=900

# --- PostgreSQL ---
POSTGRES_USER=mediavault
POSTGRES_PASSWORD=mediavault
POSTGRES_DB=mediavault
POSTGRES_PORT=5432
# The API composes DATABASE_URL from the values above in docker-compose.
# For running the API outside Docker, set it directly:
# DATABASE_URL=postgresql+psycopg://mediavault:mediavault@localhost:5432/mediavault

# --- Redis (rate limiting / cache) ---
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# --- Storage ---
# local = write to disk; s3 = AWS S3 / MinIO
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/storage
MAX_UPLOAD_SIZE_MB=512
# S3_BUCKET=mediavault-assets
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=            # set for MinIO, leave blank for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Ports ---
API_PORT=8000
FRONTEND_PORT=5173

# --- Bootstrap / seed ---
SEED_ON_START=true
FIRST_SUPERUSER_EMAIL=admin@mediavault.dev
FIRST_SUPERUSER_PASSWORD=ChangeMe123!

# --- Frontend ---
VITE_API_BASE=/api/v1
