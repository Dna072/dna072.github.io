# RenderFlow environment configuration (copy to .env for local use).
# All variables are prefixed RENDERFLOW_ and read by both the API and worker.

# --- General ---
RENDERFLOW_ENVIRONMENT=development
RENDERFLOW_LOG_LEVEL=INFO
RENDERFLOW_SERVICE_NAME=renderflow-api

# --- Database ---
# Local dev default is SQLite; Compose/K8s override with PostgreSQL.
# RENDERFLOW_DATABASE_URL=sqlite:///./renderflow.db
RENDERFLOW_DATABASE_URL=postgresql+psycopg://renderflow:renderflow@postgres:5432/renderflow

# --- Queue (Redis) ---
# Leave empty to use the in-process queue (single-node/dev only).
RENDERFLOW_REDIS_URL=redis://redis:6379/0
RENDERFLOW_QUEUE_KEY=renderflow:queue

# --- Object storage ---
RENDERFLOW_STORAGE_BACKEND=local        # local | s3
RENDERFLOW_STORAGE_LOCAL_DIR=/data/storage
# RENDERFLOW_S3_BUCKET=renderflow-media
# RENDERFLOW_S3_ENDPOINT_URL=            # e.g. http://minio:9000 for MinIO
# RENDERFLOW_S3_REGION=us-east-1

# --- Retry / backoff policy ---
RENDERFLOW_DEFAULT_MAX_RETRIES=3
RENDERFLOW_RETRY_BACKOFF_BASE_SECONDS=2.0
RENDERFLOW_RETRY_BACKOFF_MAX_SECONDS=300.0
RENDERFLOW_RETRY_BACKOFF_JITTER_SECONDS=1.0

# --- Worker ---
RENDERFLOW_WORKER_POLL_INTERVAL_SECONDS=1.0
RENDERFLOW_WORKER_HEARTBEAT_INTERVAL_SECONDS=5.0
RENDERFLOW_WORKER_STALE_AFTER_SECONDS=30.0
RENDERFLOW_JOB_LEASE_SECONDS=600.0

# --- Processing ---
# Set true to skip ffmpeg and emit deterministic mock outputs (handy in CI).
RENDERFLOW_FORCE_MOCK_PROCESSING=false
RENDERFLOW_FFMPEG_BINARY=ffmpeg
RENDERFLOW_FFPROBE_BINARY=ffprobe
