# RenderFlow environment configuration
# Copy to `.env` and adjust for local development. Never commit real secrets.

# --- Postgres ---
POSTGRES_USER=renderflow
POSTGRES_PASSWORD=renderflow_dev_password
POSTGRES_DB=renderflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full DSN used by the API/worker/alembic (overrides the discrete vars above if set)
DATABASE_URL=postgresql+psycopg2://renderflow:renderflow_dev_password@postgres:5432/renderflow

# --- Redis (queue + delayed retry set) ---
REDIS_URL=redis://redis:6379/0
QUEUE_KEY=renderflow:queue
DELAYED_QUEUE_KEY=renderflow:delayed

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# Interval (seconds) the API's background scheduler uses to reap stale
# in-flight jobs and promote due delayed retries back onto the queue.
SCHEDULER_INTERVAL_SECONDS=5
# A job in "processing" with no heartbeat for this many seconds is
# considered abandoned (crashed/killed worker) and requeued.
HEARTBEAT_TIMEOUT_SECONDS=45

# --- Worker ---
WORKER_CONCURRENCY=1
WORKER_POLL_TIMEOUT_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=10
JOB_MAX_RETRIES=3
# Base delay (seconds) for exponential backoff between retries: delay = RETRY_BACKOFF_BASE_SECONDS * 2^retries
RETRY_BACKOFF_BASE_SECONDS=10

# Storage root for input/output media (mounted volume in Compose/K8s;
# S3 in the AWS deployment sketch described in README.md).
MEDIA_STORAGE_PATH=/data/media

# Set to "1"/"true" to always use the mock FFmpeg adapter (used automatically
# in CI or any environment without a real `ffmpeg` binary on PATH).
FORCE_MOCK_FFMPEG=false

# --- Frontend (build-time, see frontend/.env.example) ---
VITE_API_BASE_URL=http://localhost:8000
