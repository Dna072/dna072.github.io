# Copy to secret.yaml and fill in real values. Never commit secret.yaml.
#
# For production on AWS/EKS, prefer External Secrets Operator syncing from
# AWS Secrets Manager or SSM Parameter Store instead of hand-managed Secrets.
#
# Example ExternalSecret (requires external-secrets.io/v1):
# ---
# apiVersion: external-secrets.io/v1
# kind: ExternalSecret
# metadata:
#   name: renderflow-db
# spec:
#   refreshInterval: 1h
#   secretStoreRef:
#     name: aws-secrets-manager
#     kind: ClusterSecretStore
#   target:
#     name: renderflow-secrets
#   data:
#     - secretKey: POSTGRES_PASSWORD
#       remoteRef:
#         key: renderflow/prod/postgres
#         property: password
#     - secretKey: DATABASE_URL
#       remoteRef:
#         key: renderflow/prod/postgres
#         property: database_url
---
apiVersion: v1
kind: Secret
metadata:
  name: renderflow-secrets
  labels:
    app.kubernetes.io/name: renderflow
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME"
  DATABASE_URL: "postgresql+psycopg2://renderflow:CHANGE_ME@postgres.renderflow.svc.cluster.local:5432/renderflow"
