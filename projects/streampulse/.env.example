# Copy to .env and adjust as needed. Docker Compose reads this file.

# --- Postgres ---
POSTGRES_USER=streampulse
POSTGRES_PASSWORD=streampulse
POSTGRES_DB=streampulse

# --- API ---
# Generate a real secret with: openssl rand -hex 32
SECRET_KEY=dev-only-change-me-32-characters-minimum
ENVIRONMENT=development
LOG_JSON=true

# Seed demo data on first boot (idempotent — skips when videos already exist).
RUN_SEED=true
SEED_DAYS=120
SEED_TRAFFIC=1.0

# Origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Frontend ---
# Where the browser reaches the API (host-published port).
VITE_API_BASE_URL=http://localhost:8000
