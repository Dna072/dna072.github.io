# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON logs for production log aggregators; set false for pretty local logs.
LOG_JSON=true

# --- Database ---
# SQLAlchemy URL. In docker-compose the host is the "postgres" service.
DATABASE_URL=postgresql+psycopg2://streampulse:streampulse@postgres:5432/streampulse

# --- Auth ---
# CHANGE THIS IN PRODUCTION. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# Demo login created by the seed script.
SEED_ADMIN_EMAIL=demo@streampulse.dev
SEED_ADMIN_PASSWORD=streampulse-demo

# --- Seed volume knobs ---
SEED_DAYS=120
SEED_TRAFFIC=1.0
SEED_RANDOM_SEED=42

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
